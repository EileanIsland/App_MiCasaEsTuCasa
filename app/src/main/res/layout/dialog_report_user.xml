<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvReportTitle"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="@string/report_user"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvReportSubtitle"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="8dp"

        android:text="@string/report_reason"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <RadioGroup
        android:id="@+id/reportReasonGroup"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="16dp">

        <RadioButton
            android:id="@+id/rbSpam"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/report_spam" />

        <RadioButton
            android:id="@+id/rbScam"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/report_scam" />

        <RadioButton
            android:id="@+id/rbOffensive"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/report_offensive" />

        <RadioButton
            android:id="@+id/rbOther"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/report_other" />

    </RadioGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/descriptionLayout"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="16dp"

        android:hint="@string/description"

        android:visibility="gone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDescription"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:inputType="textMultiLine"

            android:minLines="3"
            android:maxLines="5"

            android:gravity="top|start" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>