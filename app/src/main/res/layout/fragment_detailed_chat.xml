<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/chatDetailRoot"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="?attr/backgroundColor">

    <View
        android:id="@+id/toolbar_divider"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="?attr/colorOutlineVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chat_detail_toolbar">
    </View>


    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/chat_detail_toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:contentInsetStartWithNavigation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="8dp"
            tools:ignore="RtlSymmetry">

            <!-- Immagine Profilo -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivUserProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                tools:src="@tools:sample/avatars" />

            <!-- Nome Utente / Titolo -->
            <TextView
                android:id="@+id/tvChatUserName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Nome Utente"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <!-- Icona Segnala -->
            <ImageButton
                android:id="@+id/btnReportChat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/segnala_chat"
                android:src="@drawable/ic_report"
                app:tint="?attr/colorError" />

            <!-- Icona Elimina -->
            <ImageButton
                android:id="@+id/btnDeleteChat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/elimina_chat"
                android:src="@drawable/ic_delete"
                app:tint="?attr/colorOnSurfaceVariant" />

            <!-- Icona Recensione (Stella) -->
            <ImageButton
                android:id="@+id/btnRateUser"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Recensisci"
                android:src="@drawable/ic_star"
                android:visibility="gone"
                app:tint="?attr/colorPrimary"
                tools:visibility="visible" />

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>


    <include
        android:id="@+id/user"
        android:layout_width="260dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="10dp"
        android:gravity="start"

        layout="@layout/item_house"

        app:layout_constraintTop_toBottomOf="@id/toolbar_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Lista messaggi -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:padding="12dp"

        android:clipToPadding="false"

        app:layout_constraintTop_toBottomOf="@id/user"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/layoutSendMessage"
        app:layout_constraintEnd_toEndOf="parent"

        tools:listitem="@layout/item_message_sent"

        tools:itemCount="5"/>



    <!-- Barra invio messaggio -->
    <LinearLayout

        android:id="@+id/layoutSendMessage"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="horizontal"

        android:gravity="center_vertical"

        android:padding="8dp"

        android:background="?attr/colorSurface"

        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent">



        <!-- Allegati -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAttach"

            android:layout_width="48dp"
            android:layout_height="48dp"

            android:contentDescription="@string/allega_immagine"

            android:padding="0dp"

            app:icon="@drawable/ic_photo"

            app:iconGravity="textStart"

            app:iconPadding="0dp"

            app:cornerRadius="24dp"/>



        <!-- Campo testo -->
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:layout_marginHorizontal="8dp"
            android:textColorHint="?attr/hintTextColor"

            android:minHeight="48dp"

            android:maxLines="4"

            android:hint="@string/scrivi_messaggio"/>


        <!-- Invio -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"

            android:contentDescription="@string/invia_messaggio"

            android:padding="0dp"

            app:icon="@drawable/ic_send"

            app:iconGravity="textStart"

            app:iconPadding="0dp"

            app:cornerRadius="24dp"/>



    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>


