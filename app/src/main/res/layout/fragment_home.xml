<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".ui.fragment.HomeFragment">

    <!-- Toolbar -->
    <include
        android:id="@+id/home_toolbar"
        layout="@layout/custom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scroll -->
    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/home_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- HERO -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp">

                <ImageView
                    android:id="@+id/imgHero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/home_hero"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null"/>

                <!-- Overlay -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#70000000"/>

                <!-- Testo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="bottom"
                    android:layout_marginBottom="28dp"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/txtTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mi_casa_es_tu_casa"
                        android:textColor="?attr/colorOnPrimary"
                        android:textStyle="bold"
                        android:textSize="34sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/ogni_viaggio_comincia_aprendo_una_porta"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="17sp"/>
                </LinearLayout>
            </FrameLayout>


            <!-- Barra di ricerca -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/searchCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="-36dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardCornerRadius="40dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- Campo di ricerca -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dove_vuoi_andare"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:layout_marginStart="15dp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxBackgroundMode="none"
                            app:hintEnabled="false"
                            >

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSearch"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:hint="@string/citt_regione_o_paese"
                                android:imeOptions="actionSearch"
                                android:inputType="text"
                                android:maxLines="1"
                                android:textColor="?attr/colorOnSurface"
                                android:textColorHint="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <!-- Pulsante ricerca -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExecuteSearch"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="16dp"
                        android:contentDescription="@string/bottone_ricerca"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text=""
                        app:backgroundTint="?attr/colorPrimary"
                        app:cornerRadius="28dp"
                        app:icon="@drawable/ic_search"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="?attr/colorOnPrimary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- BENVENUTO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/benvenuto"
                    android:textColor="?attr/colorSecondary"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/trova_un_luogo_speciale_dove_sentirti_davvero_a_casa"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    android:textSize="22sp"/>
            </LinearLayout>

            <!-- ESPLORA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginStart="20dp"
                android:text="@string/esplora"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                android:textSize="22sp"/>

            <HorizontalScrollView
                android:id="@+id/scrollCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingTop="18dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <!-- Casa -->
                    <LinearLayout
                        android:id="@+id/catCasa"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            app:cardCornerRadius="32dp"
                            app:cardBackgroundColor="@color/rose">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/home"
                                android:padding="16dp"
                                android:src="@drawable/ic_home"
                                app:tint="@color/white"
                                tools:ignore="ImageContrastCheck" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_marginTop="8dp"
                            android:text="@string/casa"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="12sp"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content" />
                    </LinearLayout>


                    <!-- Appartamento -->
                    <LinearLayout
                        android:id="@+id/catAppartamento"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        tools:ignore="TextSizeCheck">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            app:cardBackgroundColor="@color/azzurro"
                            app:cardCornerRadius="32dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/home"
                                android:padding="16dp"
                                android:src="@drawable/ic_appartamento"
                                app:tint="@color/white"
                                tools:ignore="ImageContrastCheck" />
                        </com.google.android.material.card.MaterialCardView>


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/appartamento"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Stanza -->
                    <LinearLayout
                        android:id="@+id/catStanza"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            app:cardCornerRadius="32dp"
                            app:cardBackgroundColor="?attr/colorSecondary">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/Stanza"
                                android:padding="16dp"
                                android:src="@drawable/ic_stanza"
                                app:tint="@color/white"
                                tools:ignore="ImageContrastCheck" />
                        </com.google.android.material.card.MaterialCardView>


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/Stanza"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <!-- Giardino -->
                    <LinearLayout
                        android:id="@+id/catGiardino"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            app:cardCornerRadius="32dp"
                            app:cardBackgroundColor="@color/green">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/giardino"
                                android:padding="16dp"
                                android:src="@drawable/ic_giardino"
                                app:tint="@color/white"
                                tools:ignore="ImageContrastCheck" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/giardino"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- DESTINAZIONI -->
            <LinearLayout
                android:id="@+id/destinazioni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:paddingHorizontal="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/destinazioni_da_sogno"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:textColor="?attr/colorOnSurface"/>

                <TextView
                    android:id="@+id/btnVediTutto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vedi_tutto"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvNoResults"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nessuna_casa_trovata"
                android:visibility="gone"
                android:layout_marginTop="16dp"
                android:layout_gravity="center"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/destinazioni" />

            <!--anteprima case-->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHouses"
                android:layout_width="wrap_content"
                android:layout_height="380dp"
                android:layout_marginTop="18dp"
                android:contentDescription="@string/annunci_case"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                tools:listitem="@layout/item_house"

                />


            <!-- Card pubblica -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="?attr/colorPrimary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hai_una_casa_speciale"
                        android:textStyle="bold"
                        android:textSize="24sp"
                        android:textColor="?attr/colorOnPrimary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/apri_la_porta_a_nuovi_viaggiatori_e_condividi_un_luogo_pieno_di_ricordi"
                        android:textColor="?attr/colorOnPrimary"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPublish"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="?attr/colorSecondary"
                        android:minHeight="48dp"
                        android:contentDescription="@string/Pubblica_un_alloggio"
                        android:text="@string/Pubblica_un_alloggio"
                        android:textColor="?attr/colorOnSecondary"
                        app:cornerRadius="24dp" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>