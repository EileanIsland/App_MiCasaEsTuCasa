<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:backgroundTint="?attr/colorSurface"
    >


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="15dp"
        android:paddingVertical="12dp">

        <!--immagine circolare-->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/reviewerImage"
            android:layout_width="48dp"
            android:layout_height="48dp"

            android:contentDescription="@null"
            android:src="@drawable/ic_person"
            android:alpha="0.5"
            android:tint="?attr/colorOnSurface"

            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImage"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!--nome user-->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/reviewerName"

            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"

            android:text="@string/segnaposto"
            android:textStyle="bold"

            tools:text="User nome"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/reviewerImage"
            app:layout_constraintEnd_toStartOf="@id/reviewRating" />



        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/reviewRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/segnaposto"
            android:drawableEnd="@drawable/ic_star"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"

            tools:text="4.5/5"/>


        <!--data review-->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/reviewDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:text="@string/segnaposto"

            app:layout_constraintTop_toBottomOf="@id/reviewerName"
            app:layout_constraintStart_toStartOf="@id/reviewerName"

            tools:text="12/12/2009"/>

        <!-- review-->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/reviewText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            android:text="@string/segnaposto"

            app:layout_constraintTop_toBottomOf="@id/reviewDate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"

            tools:text="Casa stupenda, super consigliata!"/>

        <!-- Separatore in basso -->
        <View
            android:id="@+id/bottomDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="?attr/colorOutlineVariant"
            app:layout_constraintTop_toBottomOf="@id/reviewText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
