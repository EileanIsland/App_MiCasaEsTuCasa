<?xml version="1.0" encoding="utf-8"?>

<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">


    <!-- LOGIN  -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.micasaestucasa.ui.fragment.auth.LoginFragment">

        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment" />

        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />

        <action
            android:id="@+id/action_loginFragment_to_adminFragment"
            app:destination="@id/statisticheFragment" />
    </fragment>


    <!--Registrazione-->
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.micasaestucasa.ui.fragment.auth.RegistrationFragment">

        <action
            android:id="@+id/action_registrationFragment_to_homeFragment"
            app:destination="@id/homeFragment" />

        <action
            android:id="@+id/action_registrationFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>


    <!-- HOME -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.micasaestucasa.ui.fragment.home.HomeFragment">

        <action
            android:id="@+id/action_homeFragment_to_publishFragment"
            app:destination="@id/publishFragment" />

        <action
            android:id="@+id/action_homeFragment_to_searchFragment"
            app:destination="@id/searchFragment" />

        <action
            android:id="@+id/action_homeFragment_to_detailedHouseFragment"
            app:destination="@id/detailedHouseFragment" />


    </fragment>

    <!-- DETAILED HOUSE -->
    <fragment
        android:id="@+id/detailedHouseFragment"
        android:name="com.example.micasaestucasa.ui.fragment.detailedHouse.DetailedHouseFragment">
        <argument
            android:name="houseId"
            app:argType="string">
        </argument>

        <argument
            android:name="userId"
            app:argType="string">
        </argument>

        <action
            android:id="@+id/action_detailedHouseFragment_to_chatFragment"
            app:destination="@id/chatFragment" />

        <action
            android:id="@+id/action_detailedHouseFragment_to_detailedChatFragment"
            app:destination="@id/detailedChatFragment" />

        <action
            android:id="@+id/action_detailedHouseFragment_to_userProfileFragment"
            app:destination="@id/userProfileFragment" />

        <action
            android:id="@+id/action_detailedHouseFragment_to_bookHouseFragment"
            app:destination="@id/bookingFragment" />

        <action
            android:id="@+id/action_detailedHouseFragment_to_profileFragment"
            app:destination="@id/profileFragment" />

    </fragment>


    <!-- BookHouse -->
    <fragment
        android:id="@+id/bookingFragment"
        android:name="com.example.micasaestucasa.ui.fragment.booking.BookingFragment">
        <argument
            android:name="houseId"
            app:argType="string">
        </argument>

        <argument
            android:name="bookingId"
            app:argType="string">
        </argument>

        <argument
            android:name="isReadOnly"
            app:argType="boolean">
        </argument>

        <action
            android:id="@+id/action_bookingFragment_to_detailedHouseFragment"
            app:destination="@id/detailedHouseFragment" />
    </fragment>


    <!-- CHAT -->
    <fragment
        android:id="@+id/chatFragment"
        android:name="com.example.micasaestucasa.ui.fragment.chat.ChatFragment">

        <action
            android:id="@+id/action_chatFragment_to_detailedChatFragment"
            app:destination="@id/detailedChatFragment"/>

        <argument
            android:name="chatId"
            app:argType="string">
        </argument>

        <argument
            android:name="otherUserId"
            app:argType="string">
        </argument>


    </fragment>

    <!-- DETAILED CHAT -->
    <fragment
        android:id="@+id/detailedChatFragment"
        android:name="com.example.micasaestucasa.ui.fragment.chat.DetailedChatFragment"/>


    <!-- SEARCH -->
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.micasaestucasa.ui.fragment.search.SearchFragment">

        <argument
            android:name="category"
            app:argType="string">
        </argument>

        <argument
            android:name="query"
            app:argType="string">
        </argument>

        <action
            android:id="@+id/action_searchFragment_to_detailedHouseFragment"
            app:destination="@id/detailedHouseFragment"/>

    </fragment>


    <!-- Activities -->
    <fragment
        android:id="@+id/activitiesFragment"
        android:name="com.example.micasaestucasa.ui.fragment.activities.ActivitiesFragment">

        <action
            android:id="@+id/action_ownerActivitiesFragment_to_publishFragment"
            app:destination="@+id/publishFragment"
            >
        </action>

        <action
            android:id="@+id/action_ownerActivitiesFragment_to_detailedHouseFragment"
            app:destination="@id/detailedHouseFragment"
            >
        </action>

        <action
            android:id="@+id/action_ownerActivitiesFragment_to_bookingFragment"
            app:destination="@id/bookingFragment"
            >
        </action>

        <action
            android:id="@+id/action_guestActivitiesFragment_to_bookingFragment"
            app:destination="@id/bookingFragment"
            >
        </action>

        <action
            android:id="@+id/action_guestActivitiesFragment_to_reviewFragment"
            app:destination="@id/reviewFragment"
            >
        </action>

        <action
            android:id="@+id/action_guestActivitiesFragment_to_userProfileFragment"
            app:destination="@id/userProfileFragment"
            >
        </action>

        <action
            android:id="@+id/action_guestActivitiesFragment_to_detailedChatFragment"
            app:destination="@id/detailedChatFragment"
            >
        </action>

        <action
            android:id="@+id/action_ownerActivitiesFragment_to_userProfileFragment"
            app:destination="@id/userProfileFragment"
            >
        </action>

        <action
            android:id="@+id/action_ownerActivitiesFragment_to_detailedChatFragment"
            app:destination="@id/detailedChatFragment"
            >
        </action>
    </fragment>




    <!-- Guest-->
    <fragment
        android:id="@+id/guestActivitiesFragment"
        android:name="com.example.micasaestucasa.ui.fragment.activities.GuestActivitiesFragment">

    </fragment>

    <!--host-->
    <fragment
        android:id="@+id/ownerActivitiesFragment"
        android:name="com.example.micasaestucasa.ui.fragment.activities.OwnerActivitiesFragment">
    </fragment>

    <!--RECENSIONE-->
    <fragment
        android:id="@+id/reviewFragment"
        android:name="com.example.micasaestucasa.ui.fragment.review.ReviewFragment">

        <argument
            android:name="houseId"
            app:argType="string">
        </argument>

        <argument
            android:name="bookingId"
            app:argType="string">
        </argument>

        <argument
            android:name="userId"
            app:argType="string">
        </argument>
    </fragment>


    <!-- PROFILO personale -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.micasaestucasa.ui.fragment.profile.ProfileFragment">

        <action
            android:id="@+id/action_profileFragment_to_modifyProfileFragment"
            app:destination="@id/modifyProfileFragment"/>

        <action
            android:id="@+id/action_profileFragment_to_LoginFragment"
            app:destination="@id/loginFragment"/>

    </fragment>



    <!-- profilo utente generico-->
    <fragment
        android:id="@+id/userProfileFragment"
        android:name="com.example.micasaestucasa.ui.fragment.profile.UserProfileFragment">

        <argument
            android:name="userId"
            app:argType="string">
        </argument>

        <action
            android:id="@+id/action_userProfileFragment_to_chatFragment"
            app:destination="@id/chatFragment"/>
        <action
            android:id="@+id/action_userProfileFragment_to_detailedChatFragment"
            app:destination="@id/detailedChatFragment"/>
    </fragment>



    <!-- PUBLISH -->
    <fragment
        android:id="@+id/publishFragment"
        android:name="com.example.micasaestucasa.ui.fragment.publish.PublishFragment"
        >

        <action
            android:id="@+id/action_publishFragment_to_detailedHouseFragment"
            app:destination="@id/detailedHouseFragment"/>
    </fragment>



    <!--modifica profilo-->
    <fragment
        android:id="@+id/modifyProfileFragment"
        android:name="com.example.micasaestucasa.ui.fragment.profile.ModifyProfileFragment"/>



    <!--ADMIN-->
    <fragment
        android:id="@+id/statisticheFragment"
        android:name="com.example.micasaestucasa.ui.fragment.admin.AdStatsFragment"
        >
    </fragment>

    <fragment
        android:id="@+id/AdminGestioneUtenti"
        android:name="com.example.micasaestucasa.ui.fragment.admin.AdUserFragment"
        >
    </fragment>

    <fragment
        android:id="@+id/AdminTag"
        android:name="com.example.micasaestucasa.ui.fragment.admin.AdTagFragment"
        >
    </fragment>






</navigation>